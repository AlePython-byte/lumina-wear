<?xml version="1.0" encoding="utf-8"?>
<!-- Solo compilaciones de depuración: HTTP sin cifrar hacia el hub local (emulador, PC en casa y
     subred del hotspot del iPhone, 172.20.10.2 a 172.20.10.14). Todo lo demás exige HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- Emulador -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- PC en casa -->
        <domain includeSubdomains="false">192.168.80.18</domain>
        <!-- Hotspot del iPhone -->
        <domain includeSubdomains="false">172.20.10.2</domain>
        <domain includeSubdomains="false">172.20.10.3</domain>
        <domain includeSubdomains="false">172.20.10.4</domain>
        <domain includeSubdomains="false">172.20.10.5</domain>
        <domain includeSubdomains="false">172.20.10.6</domain>
        <domain includeSubdomains="false">172.20.10.7</domain>
        <domain includeSubdomains="false">172.20.10.8</domain>
        <domain includeSubdomains="false">172.20.10.9</domain>
        <domain includeSubdomains="false">172.20.10.10</domain>
        <domain includeSubdomains="false">172.20.10.11</domain>
        <domain includeSubdomains="false">172.20.10.12</domain>
        <domain includeSubdomains="false">172.20.10.13</domain>
        <domain includeSubdomains="false">172.20.10.14</domain>
    </domain-config>
</network-security-config>
